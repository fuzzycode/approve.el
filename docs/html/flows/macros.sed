# Node and edge kinds used in flows.gv.  "@dec" etc. expand to attributes.
s/@user/class="user" style="rounded,filled" fillcolor="#2a283e" color="#f6c177" fontcolor="#f6c177"/g
s/@act/class="act"/g
s/@dec/class="dec" shape=hexagon style=filled fillcolor="#2a283e" color="#c4a7e7" fontcolor="#c4a7e7"/g
s/@api/class="api" style=filled color="#3e8fb0" fontcolor="#9ccfd8"/g
s/@err/class="err" color="#eb6f92" fontcolor="#eb6f92"/g
s/@ok/class="ok" color="#9ccfd8"/g
s/@goto/class="goto" style="rounded,dashed" fillcolor="#232136" color="#c4a7e7" fontcolor="#c4a7e7" target="_top"/g
s/@note/class="note" shape=note style="" color="#56526e" fontcolor="#908caa"/g
s/@state/class="state" shape=ellipse style=filled fillcolor="#2a283e" color="#c4a7e7"/g
s/@yes/label=" yes" class="yes" fontcolor="#9ccfd8"/g
s/@no/label=" no" class="no" fontcolor="#eb6f92"/g
